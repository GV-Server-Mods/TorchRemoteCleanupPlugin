<UserControl x:Class="RemoteAbandon.Views.RemoteAbandonControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="750">
    <UserControl.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="5,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E1E1E" CornerRadius="4" Padding="15" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="🚀 Remote Grid Abandon" FontSize="20" FontWeight="Bold" Foreground="#4CAF50" VerticalAlignment="Center"/>
                    <TextBlock Text="v2.0 (Derelict Grid Abandonment &amp; Beacon Stripping)" FontSize="12" Foreground="#888888" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <Button Content="Save Configuration" Click="SaveButton_OnClick" DockPanel.Dock="Right" Background="#2E7D32" Foreground="White" BorderThickness="0"/>
            </DockPanel>
        </Border>

        <!-- Main Content Tabs -->
        <TabControl Grid.Row="1" Background="#252526" BorderBrush="#333333">
            <!-- Settings Tab -->
            <TabItem Header="Configuration">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <!-- Quick Overview Banner -->
                        <Border Background="#1F2937" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="💡 How Remote Grid Abandon Works:" FontWeight="Bold" Foreground="#60A5FA" Margin="0,0,0,4"/>
                                <TextBlock Text="• 🚀 Derelict Abandon: When players click 'X' (Remove) in Info Tab, the grid is preserved in space as a derelict rather than deleted." Foreground="#D1D5DB" TextWrapping="Wrap"/>
                                <TextBlock Text="• 🚨 Beacon Stripping: Player beacons are destroyed, while claim/scrap beacons belonging to other factions remain intact." Foreground="#D1D5DB" TextWrapping="Wrap"/>
                                <TextBlock Text="• 👤 Ownership Reset: Terminal blocks are set to Nobody (0L) and authorship is cleared to immediately refund player PCU." Foreground="#D1D5DB" TextWrapping="Wrap"/>
                                <TextBlock Text="• ⚔️ Combat Lockout: Optional safety toggle that blocks ship abandonment if enemy players are nearby." Foreground="#D1D5DB" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- General Settings -->
                        <GroupBox Header="General Settings">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <CheckBox Grid.Row="0" Content="Enable Remote Abandon Override" IsChecked="{Binding Config.Enabled}" FontWeight="Bold"/>
                                <CheckBox Grid.Row="1" Content="Enable Debug Logging (Log details to Torch console)" IsChecked="{Binding Config.EnableDebugLogging}"/>
                                <CheckBox Grid.Row="2" Content="Write Dedicated Log File (Appends to RemoteAbandon.log in plugin storage)" IsChecked="{Binding Config.WriteDedicatedLogFile}"/>
                                <CheckBox Grid.Row="3" Content="Enable In-Game Player Commands (!abandon info)" IsChecked="{Binding Config.EnablePlayerCommands}"/>
                            </Grid>
                        </GroupBox>

                        <!-- Beacon Stripping & Derelict Setup -->
                        <GroupBox Header="🚨 Beacon Stripping &amp; Derelict Setup">
                            <StackPanel>
                                <TextBlock Text="Controls beacon destruction and power state when a grid is abandoned." Foreground="#9CA3AF" FontSize="11" Margin="5,0,0,8"/>
                                <CheckBox Content="Destroy Player Beacons (Owned or built by abandoning player)" IsChecked="{Binding Config.DestroyPlayerBeacons}" FontWeight="SemiBold"/>
                                <CheckBox Content="Preserve Other Players' Beacons (Keeps scrap/claim beacons owned by other players/factions)" IsChecked="{Binding Config.PreserveOtherPlayerBeacons}"/>
                                <CheckBox Content="Depower Grid On Abandon (Turn off batteries, reactors, solar panels, engines, and wind turbines)" IsChecked="{Binding Config.DepowerGridOnAbandon}"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- Ownership & PCU Management -->
                        <GroupBox Header="👤 Ownership &amp; PCU Management">
                            <StackPanel>
                                <TextBlock Text="Configure block ownership clearing and PCU limit refunds." Foreground="#9CA3AF" FontSize="11" Margin="5,0,0,8"/>
                                <CheckBox Content="Reset Functional Block Ownership to Nobody (0L)" IsChecked="{Binding Config.ResetTerminalOwnershipToNobody}" FontWeight="SemiBold"/>
                                <CheckBox Content="Transfer Authorship (BuiltBy) away from player to refund PCU" IsChecked="{Binding Config.TransferAuthorshipToNobody}"/>
                                
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="Custom Owner / NPC Identity ID (0 for Nobody):"/>
                                    <TextBox Grid.Column="1" Text="{Binding Config.CustomOwnerIdentityId}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- Combat & Anti-Exploit Rules -->
                        <GroupBox Header="⚔️ Combat &amp; Anti-Exploit Rules">
                            <StackPanel>
                                <TextBlock Text="Prevent players from using Info Tab grid abandonment to combat-log or exploit limits." Foreground="#9CA3AF" FontSize="11" Margin="5,0,0,8"/>
                                <CheckBox Content="Prevent Abandon In Combat (Block if hostile players are nearby)" IsChecked="{Binding Config.PreventAbandonInCombat}" FontWeight="SemiBold"/>
                                <CheckBox Content="Prevent Abandon On Damage (Block if grid or subgrids took damage recently)" IsChecked="{Binding Config.PreventAbandonOnDamage}" FontWeight="SemiBold"/>
                                
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Content="Combat Check Radius (Meters):"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Config.CombatCheckRadius, StringFormat={}{0:F0}}"/>

                                    <Label Grid.Row="1" Grid.Column="0" Content="Damage Cooldown (Seconds):"/>
                                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Config.DamageCooldownSeconds}"/>

                                    <Label Grid.Row="2" Grid.Column="0" Content="Max Grid PCU Limit (0 = Unlimited):"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Config.MaxGridPCU}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>

                        <!-- Player Notifications -->
                        <GroupBox Header="💬 Player Notifications">
                            <StackPanel>
                                <CheckBox Content="Send Notification To Player on Abandon" IsChecked="{Binding Config.SendNotificationToPlayer}" FontWeight="SemiBold"/>
                                <Grid Margin="0,5,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0" Content="Notification Message ({0} = Grid Name):"/>
                                    <TextBox Grid.Column="1" Text="{Binding Config.NotificationMessage}"/>
                                </Grid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Statistics Tab -->
            <TabItem Header="Live Telemetry">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Real-Time Grid Abandonment &amp; Stripping Telemetry" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,0,0,15"/>

                    <StackPanel Grid.Row="1">
                        <Border Background="#1A1A1A" CornerRadius="4" Padding="15" Margin="0,0,0,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="Grids Abandoned" Foreground="#888888" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Statistics.TotalGridsAbandoned, StringFormat={}{0:N0}}" FontSize="20" FontWeight="Bold" Foreground="#2196F3" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="Subgrids Handled" Foreground="#888888" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Statistics.TotalSubgridsProcessed, StringFormat={}{0:N0}}" FontSize="20" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="Beacons Destroyed" Foreground="#888888" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Statistics.TotalBeaconsDestroyed, StringFormat={}{0:N0}}" FontSize="20" FontWeight="Bold" Foreground="#E91E63" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                                    <TextBlock Text="Combat Lockouts" Foreground="#888888" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding Statistics.TotalCombatBlocked, StringFormat={}{0:N0}}" FontSize="20" FontWeight="Bold" Foreground="#FF9800" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <GroupBox Header="Detailed Telemetry Breakdown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="🚨 Beacons Destroyed:"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Statistics.TotalBeaconsDestroyed, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#E91E63"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="💰 Total PCU Refunded:"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Statistics.TotalPcuRefunded, StringFormat={}{0:N0}}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#2196F3"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="🚀 Last Abandoned Grid:"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Statistics.LastAbandonedGridName}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#CCCCCC"/>

                                <Label Grid.Row="3" Grid.Column="0" Content="👤 Last Player SteamID:"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Statistics.LastAbandonedPlayerSteamId}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#CCCCCC"/>

                                <Label Grid.Row="4" Grid.Column="0" Content="🕒 Last Abandon Timestamp:"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Statistics.LastAbandonedTimestamp}" VerticalAlignment="Center" FontWeight="Bold" Foreground="#FFEB3B"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>

                    <Button Grid.Row="2" Content="Reset Telemetry Counters" Click="ResetStatsButton_OnClick" HorizontalAlignment="Left" Background="#C62828" Foreground="White" BorderThickness="0"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

